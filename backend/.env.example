# Copia este archivo como .env y rellena los valores reales.
# .env está en .gitignore y NUNCA debe subirse al repositorio.
MONGO_URL=mongodb://usuario:clave@localhost:27017
DB_NAME=dirt_comunitario
# Opcional: orígenes permitidos separados por comas.
# Si se omite, se permite cualquier origen (sin credenciales).
ALLOWED_ORIGINS=
